{
  "name": "hacerpedido-webapp",
  "packageManager": "pnpm@11.25.0",
  "imports": {
    "#assets/*": "./assets/*",
    "#components/*": "./components/*",
    "#db/*": "./db/*",
    "#lib/*": "./lib/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "tsx scripts/ensure-dev-services.ts && pnpm test && pnpm run test:e2e && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "tsx scripts/ensure-dev-services.ts --check && jest",
    "test:coverage": "tsx scripts/ensure-dev-services.ts --check && jest --coverage --runInBand",
    "test:db": "tsx scripts/test-db-contracts.ts",
    "test:e2e": "tsx scripts/ensure-dev-services.ts --check && playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:info": "tsx scripts/e2e-info.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:make": "drizzle-kit generate",
    "db:migrate:status": "tsx scripts/db-migrate.ts status",
    "db:explain": "tsx scripts/db-explain.ts",
    "db:seed": "pnpm run db:up && tsx scripts/db-seed.ts db/seeds/dev/001_dev_data.ts",
    "db:seed:test": "tsx scripts/db-seed.ts tests/e2e/fixtures/seeds/001_test_data.ts",
    "db:seed:e2e": "pnpm run db:seed:test",
    "db:up": "docker compose -f compose.dev.yaml up --detach --wait",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:create": "pnpm run db:up",
    "db:setup": "pnpm run db:create && pnpm run db:migrate && pnpm run db:seed",
    "db:reset": "docker compose -f compose.dev.yaml down --volumes --remove-orphans && pnpm run db:setup",
    "db:logs": "docker compose -f compose.dev.yaml logs --follow postgres",
    "db:check": "docker compose -f compose.dev.yaml exec postgres pg_isready -U dev_user -d hacerpedido_dev",
    "lint": "biome lint .",
    "lint:markdown": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "deps:check": "depcheck --skip-missing --ignores='pg,lefthook,typescript,@types/node,@types/react,@types/react-dom,jest-environment-node'",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@handsontable/react-wrapper": "18.1.0",
    "@sentry/nextjs": "^10.73.0",
    "bootstrap": "^4.6.2",
    "drizzle-orm": "^0.45.2",
    "handsontable": "18.1.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.87.0",
    "react-image-crop": "^11.1.2",
    "react-spring": "^8.0.27",
    "react-timeago": "^8.3.0",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@faker-js/faker": "^10.6.0",
    "@next/env": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.1",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "jest-environment-node": "30.5.1",
    "lefthook": "^2.1.12",
    "markdownlint-cli2": "^0.23.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
