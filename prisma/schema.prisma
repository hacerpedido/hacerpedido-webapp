generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_CONNECTION_STRING")
}

model products {
  id          String    @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  category    String
  name        String
  description String?
  price       String?
  shopid      String    @db.Uuid
  itemnumber  Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  shops       shops     @relation(fields: [shopid], references: [id])
}

model shops {
  id                      String     @id @default(dbgenerated("uuid_generate_v1()")) @db.Uuid
  name                    String
  slug                    String     @unique
  region                  String
  username                String?
  category                String?
  address                 String?
  notes                   String?
  ordersbyphoneorwhatsapp String?
  delivery                String?
  takeaway                String?
  whatsappnumber          String?
  phonenumber             String?
  email                   String?
  submittedat             String?
  opentimes               String?
  deliverycost            String?
  visibility              String?
  logo                    String?
  background              String?
  typeformtoken           String?
  ordersphonenumber       String?
  orderswhatsappnumber    String?
  created_at              DateTime?  @default(now()) @db.Timestamp(6)
  updated_at              DateTime?  @default(now()) @db.Timestamp(6)
  products                products[]
}
