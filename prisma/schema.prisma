generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_CONNECTION_STRING")
}

model Product {
  id          String    @id @default(dbgenerated("extensions.uuid_generate_v1()")) @db.Uuid
  category    String
  name        String
  description String?
  shopid      String    @db.Uuid
  itemnumber  Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  price       Decimal?
  shop        Shop      @relation(fields: [shopid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("products")
}

model Shop {
  id                      String    @id @default(dbgenerated("extensions.uuid_generate_v1()")) @db.Uuid
  name                    String
  slug                    String    @unique
  region                  String
  username                String?
  category                String
  address                 String?
  notes                   String?
  ordersbyphoneorwhatsapp String?
  delivery                String?
  takeaway                String?
  whatsappnumber          String?
  phonenumber             String?
  email                   String?
  submittedat             String?
  opentimes               String?
  deliverycost            String?
  visibility              String?
  logo                    String?
  background              String?
  typeformtoken           String?   @unique
  ordersphonenumber       String?
  orderswhatsappnumber    String?
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  products                Product[]

  @@map("shops")
}
