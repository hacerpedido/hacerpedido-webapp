# Local development database (compose.dev.yaml)
PG_CONNECTION_STRING=postgresql://dev_user:dev_password@127.0.0.1:54328/hacerpedido_dev

# Optional application settings (do not put credentials in this file)
# Set this in Vercel for production and preview canonical URLs.
# NEXT_PUBLIC_SITE_URL=https://hacerpedido.com
# S3 image uploads (set in the local environment or Vercel; never commit credentials)
# HP_AWS_ACCESS_KEY_ID=
# HP_AWS_SECRET_ACCESS_KEY=
# HP_AWS_IMAGES_BUCKET=
# NEXT_PUBLIC_IMAGE_BUCKET_URL=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Sentry source map upload (set in CI/Vercel, never in this file):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
