# Local development database (compose.dev.yaml)
PG_CONNECTION_STRING=postgresql://dev_user:dev_password@127.0.0.1:54328/hacerpedido_dev

# Local development S3-compatible storage (compose.dev.yaml)
# These are local-only development credentials, not cloud credentials.
DEV_S3_PORT=7070
DEV_S3_ACCESS_KEY=dev-access-key
DEV_S3_SECRET_KEY=dev-secret-key
DEV_S3_BUCKET=hacerpedido-images
HP_S3_ENDPOINT=http://localhost:7070
HP_AWS_ACCESS_KEY_ID=dev-access-key
HP_AWS_SECRET_ACCESS_KEY=dev-secret-key
HP_AWS_IMAGES_BUCKET=hacerpedido-images
NEXT_PUBLIC_IMAGE_BUCKET_URL=http://localhost:7070/hacerpedido-images

# Optional application settings
# Set this in Vercel for production and preview canonical URLs.
# NEXT_PUBLIC_SITE_URL=https://hacerpedido.com
# NEXT_PUBLIC_SENTRY_DSN=
# Sentry source map upload (set in CI/Vercel, never in this file):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
