{
  "compilerOptions": {
    "lib": [
      "es2021",
      "DOM",
      "DOM.Iterable"
    ],
    "incremental": true,
    "isolatedModules": true,
    "importsNotUsedAsValues": "error",
    "noEmit": true,
    "moduleResolution": "node",
    "module": "es2020",
    "target": "es2020",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ],
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "jest.config.js"
  ],
  "references": [
    {
      "path": "./types"
    },
    {
      "path": "./assets"
    }
  ]
}
